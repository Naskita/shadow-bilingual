{
  "name": "shadow-bilingual",
  "version": "1.0.9",
  "type": "module",
  "description": "影子双语输入 + 全英文对话：输入框实时显示英文影子译文，发送时按「发送译文」决定发译文还是原文；助手回复英文正文 + 中文对照。Shadow bilingual input for the DeepSeek Harness desktop app.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bilingual",
    "translation",
    "shadow-input",
    "english-mode",
    "英文",
    "双语",
    "英译"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naskita/shadow-bilingual.git"
  },
  "bugs": {
    "url": "https://github.com/Naskita/shadow-bilingual/issues"
  },
  "homepage": "https://github.com/Naskita/shadow-bilingual#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "check": "bash tests/run-all.sh",
    "apply": "bash scripts/apply-changes.sh"
  }
}
